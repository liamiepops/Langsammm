# Rust build output
target/

# Rendered audio. Everything here is reproducible from tools/testsig.js
# and tools/render.js.
*.wav

# Build artifact, produced by build.ps1 from src/. Un-ignore this if you ever
# want a clone to be loadable in Chrome without a Rust toolchain.
extension/langsammm.wasm

# Packaged output. build.ps1 assembles dist/firefox from extension/ with the
# Firefox manifest swapped in.
dist/

# Intermediate curve dumps from tools/envsnap.js. The mockups embed their own
# copy of the data, so these are not needed to render anything.
design/snap*.json

# Icon comparison output, all reproducible from tools/icons.js,
# tools/icon-sheet.js and tools/icon-compare.js. The shipped mark in
# extension/icons is tracked; these are just the workings.
design/icon-candidates/
design/icon-candidates.html
design/icon-contact.png

# Generated by tools/bench-page.js, and it embeds the wasm.
design/bench.html

# The site is generated by tools/site.js and embeds the wasm.
site/index.html

# Generated store artwork, captured by hand from the browser.
design/store/
site/privacy.html

{
  "manifest_version": 3,
  "name": "Slowform",
  "version": "0.1.0",
  "description": "Plays audio slowed by N semitones and warps the spectral envelope back up by the same interval.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.soundcloud.com/*",
        "*://*.bandcamp.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page.js", "worklet.js", "slowform.wasm"],
      "matches": ["*://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Slowform"
  }
}
